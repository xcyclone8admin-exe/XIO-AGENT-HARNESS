{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.1.0",
  "identifier": "systems.xyra.agentos",
  "mainBinaryName": "xyra-desktop",
  "build": {
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "shortDescription": "Governed local agent operating system",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/sidecar/": "sidecar/",
      "resources/licenses/": "licenses/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
