{
  // Dedicated resource configuration for the provisioned development environment.
  // R2 is intentionally absent until subscription activation and bucket creation are verified.
  "name": "institutional-agent-os-dev-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "AUTH_ORIGIN": "https://institutional-agent-os-dev-cloud.institutional-agent-os-dev.workers.dev",
    "AUTH_RP_ID": "institutional-agent-os-dev.workers.dev",
    "AUTH_RP_NAME": "XYRA Development",
    "AUTH_JWT_AUDIENCE": "xyra-cloud",
    "AUTH_JWT_ISSUER": "xyra-auth",
    "BLOB_MAX_BYTES": "10485760",
    "QUOTA_PRINCIPAL_RPM": "120",
    "QUOTA_PRINCIPAL_BYTES": "20000000",
    "QUOTA_ENDPOINT_RPM": "600"
  },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "1301301d96e340fa93f6f37f5abc0c0d" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "WorkspaceHub" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceHub"] }
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "institutional-agent-os-dev-jobs" },
      { "binding": "DEAD_LETTER_JOBS", "queue": "institutional-agent-os-dev-jobs-dlq" }
    ],
    "consumers": [
      {
        "queue": "institutional-agent-os-dev-jobs",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "institutional-agent-os-dev-jobs-dlq"
      }
    ]
  },
  "triggers": { "crons": ["*/15 * * * *"] }
  // Secret bindings supplied by the scoped deployment broker, never committed here:
  // NEON_DATABASE_URL, HUB_INTERNAL_TOKEN, AUTH_JWT_JWK, AUTH_SIGNING_JWK,
  // BLOB_ACCESS_SECRET, WEBHOOK_SECRET.
  // No-R2 development deployment is supported for non-blob paths; blob endpoints return 503.
  // Add BLOBS only after R2 activation and verified bucket provisioning; live blob/erasure checks stay blocked meanwhile.
}
